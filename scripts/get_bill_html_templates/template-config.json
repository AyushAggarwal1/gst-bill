{
  "externalRepo": {
    "owner": "AyushAggarwal1",
    "repo": "gstly-html-templates",
    "branch": "dev",
    "path": ""
  },
  "localPaths": {
    "externalTemplatesDir": "public/templates",
    "templateIndexFile": "public/templates/index.json"
  },
  "templateValidation": {
    "requiredPlaceholders": [
      "{{COMPANY_NAME}}",
      "{{COMPANY_ADDRESS}}",
      "{{COMPANY_GST}}",
      "{{CUSTOMER_NAME}}",
      "{{CUSTOMER_ADDRESS}}",
      "{{CUSTOMER_GST}}",
      "{{BILL_NUMBER}}",
      "{{BILL_DATE}}",
      "{{TAX_TYPE}}",
      "{{ITEMS_TABLE}}",
      "{{SUBTOTAL}}",
      "{{TAX_ROWS}}",
      "{{TOTAL}}",
      "{{AMOUNT_IN_WORDS}}"
    ],
    "optionalPlaceholders": [
      "{{COMPANY_PHONE}}",
      "{{DELIVERY_ADDRESS}}",
      "{{BANK_DETAILS}}",
      "{{PROFILE_PHOTO}}",
      "{{UPI_QR}}"
    ]
  },
  "autoUpdate": {
    "enabled": true,
    "interval": "24h",
    "lastUpdate": "2026-08-08T11:10:13.405Z"
  }
}