							"mode": "raw",
							"raw": "{\n  \"billNumber\": \"B0001\",\n  \"billDate\": \"2024-03-20T00:00:00.000Z\",\n  \"customerId\": \"customer-id\",\n  \"items\": [\n    {\n      \"itemId\": \"item-id\",\n      \"quantity\": 1,\n      \"price\": 100\n    }\n  ],\n  \"isIGST\": false,\n  \"deliveryAddress\": \"Delivery Address\"\n}"
