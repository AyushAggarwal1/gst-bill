generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String // Name of the organization/business
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  customers             Customer[]
  items                 Item[]
  bills                 Bill[]
  invitations           Invitation[]
  passwordResetRequests PasswordResetRequest[]
}

model User {
  id                    String                 @id @default(uuid())
  email                 String
  password              String?
  name                  String?
  isAdmin               Boolean                @default(false)
  tenantId              String // Every user belongs to a tenant
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  bills                 Bill[]
  customers             Customer[]
  sentInvitations       Invitation[]           @relation("SentInvitations")
  receivedInvitation    Invitation?            @relation("ReceivedInvitation")
  items                 Item[]
  profile               Profile?
  roles                 UserRole[]
  passwordResetRequests PasswordResetRequest[]

  @@unique([email, tenantId]) // Email must be unique within a tenant
  @@index([tenantId])
}

model UserRole {
  id          String       @id @default(uuid())
  userId      String
  role        Role
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Invitation {
  id            String       @id @default(uuid())
  email         String
  role          Role
  permissions   Permission[]
  invitedById   String
  invitedUserId String?      @unique
  token         String       @unique
  expiresAt     DateTime
  status        String       @default("PENDING")
  tenantId      String // The tenant this invitation is for
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  invitedBy     User         @relation("SentInvitations", fields: [invitedById], references: [id])
  invitedUser   User?        @relation("ReceivedInvitation", fields: [invitedUserId], references: [id])

  @@unique([email, tenantId]) // One email can be invited to multiple tenants, but only once per tenant
  @@index([tenantId])
}

model Profile {
  id              String  @id @default(uuid())
  firmName        String
  address         String
  gstNo           String
  phoneNo         String?
  bankDetails     String?
  defaultTemplate String? @default("billFormat.html")
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id              String   @id @default(uuid())
  name            String
  address         String
  deliveryAddress String?
  gstNo           String
  userId          String
  tenantId        String // Every customer belongs to a tenant
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bills           Bill[]
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Item {
  id          String     @id @default(uuid())
  name        String
  description String? // Optional description field
  hsnCode     String
  taxRate     Float
  userId      String
  tenantId    String // Every item belongs to a tenant
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  billItems   BillItem[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Bill {
  id              String     @id @default(uuid())
  billNumber      String
  billDate        DateTime   @default(now())
  customerId      String
  userId          String
  tenantId        String // Every bill belongs to a tenant
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  isIGST          Boolean    @default(false)
  subtotal        Float
  cgst            Float      @default(0)
  sgst            Float      @default(0)
  igst            Float      @default(0)
  total           Float
  deliveryAddress String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  customer        Customer   @relation(fields: [customerId], references: [id])
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           BillItem[]

  @@unique([billNumber, tenantId]) // Bill numbers are unique within a tenant
  @@index([tenantId])
}

model BillItem {
  id        String @id @default(uuid())
  billId    String
  itemId    String
  quantity  Int
  price     Float
  taxAmount Float
  amount    Float
  bill      Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  item      Item   @relation(fields: [itemId], references: [id])
}

model PasswordResetRequest {
  id        String    @id @default(uuid())
  email     String
  tenantId  String
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([email, tenantId])
  @@index([userId])
}

model SignupVerification {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String
  hashedPassword   String
  organizationName String?
  invitationToken  String?
  otpHash          String
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([email])
}

enum Role {
  ADMIN
  USER
}

enum Permission {
  CREATE_BILLS
  READ_BILLS
  UPDATE_BILLS
  DELETE_BILLS
  CREATE_CUSTOMERS
  READ_CUSTOMERS
  UPDATE_CUSTOMERS
  DELETE_CUSTOMERS
  CREATE_ITEMS
  READ_ITEMS
  UPDATE_ITEMS
  DELETE_ITEMS
  INVITE_USERS
}
